# Copy to .env and fill in. .env is git-ignored. Never commit real values.

# --- Neon Postgres (Habit10x production database) ---
# Use a READ-ONLY role. The connector also forces read-only transactions as a second guard.
# Neon connection string, with sslmode=require.
DATABASE_URL=

# --- OpenPanel (read API) ---
# Must be a client of type "read" or "root" (a "write" client is rejected by the read API).
# Dashboard: OpenPanel -> Project settings -> Clients.
OPENPANEL_CLIENT_ID=
OPENPANEL_CLIENT_SECRET=
# Project ID (the id in the OpenPanel dashboard URL / project settings).
OPENPANEL_PROJECT_ID=
# Change only if you self-host OpenPanel.
OPENPANEL_API_URL=https://api.openpanel.dev

# --- Site ---
# Used to build links in alert emails (e.g. {SITE_URL}/challenge/<id>).
SITE_URL=https://ssharp.app

# --- Alert email ---
# Option A (recommended once you have a verified domain): Resend.
RESEND_API_KEY=
# Must be an address on your verified Resend domain, e.g. Habit10x Alerts <alerts@ssharp.app>
# (for Gmail SMTP below, use your Gmail address).
ALERT_FROM_EMAIL=
# Comma-separated list of recipients.
ALERT_RECIPIENTS=

# Option B (works today with no domain): Gmail SMTP with an App Password.
# Leave RESEND_API_KEY empty to use this. Resend wins if both are set.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Alert engine ---
# Accounts on these email domains never trigger alerts (bulk-upload / test data). Comma-separated.
TEST_EMAIL_DOMAINS=fake.com,habit10x.internal,example.com
# Your own team's addresses, so testing the site never triggers alerts. Comma-separated.
TEAM_EMAILS=
# Where rule settings, alert history and "already alerted" markers are stored (SQLite file; contains user emails).
TRACTION_DB_PATH=data/traction.db
# Optional: password for the Streamlit dashboard. REQUIRED before exposing the dashboard beyond this computer.
DASHBOARD_PASSWORD=

# --- Social media tracker (views / likes / comments of short videos) ---
# Folder with the Excel file(s) of video links (a column of URLs). Relative paths are inside the project folder.
SOCIAL_INPUT_DIR=input
# Optional. YouTube Data API key: more reliable than reading the page, and works from a server.
YOUTUBE_API_KEY=
# Optional. Proxy used for TikTok only (TikTok is blocked in India), e.g. http://user:pass@host:port
SOCIAL_PROXY=
# Optional. Netscape cookies.txt of a logged-in browser, to help Instagram / X when they ask for a login.
SOCIAL_COOKIES_FILE=
